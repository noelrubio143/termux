#!/data/data/com.termux/files/usr/bin/bash
# Termux SCRIPT - UNIFIED VERSION WITH IPv4/IPv6
# Complete integrated installer with dual-stack networking

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

VER="4.3-UNIFIED"

# ============================================================================
# DETECTION & VALIDATION
# ============================================================================

detect_architecture() {
    case "$(uname -m)" in
        aarch64) echo "aarch64" ;;
        x86_64) echo "x86_64" ;;
        armv7l|armv8l|arm) echo "arm" ;;
        i*86) echo "i686" ;;
        *) echo "unknown" ;;
    esac
}

validate_termux() {
    if [ ! -d "/data/data/com.termux" ]; then
        echo -e "${RED}ERROR: This script is for Termux only!${NC}"
        exit 1
    fi
}

validate_architecture() {
    ARCH_TYPE="$(detect_architecture)"
    if [[ "$ARCH_TYPE" != "aarch64" && "$ARCH_TYPE" != "x86_64" ]]; then
        echo -e "${RED}Unsupported architecture: $ARCH_TYPE${NC}"
        echo -e "${YELLOW}Please use aarch64 or x86_64 device${NC}"
        exit 1
    fi
}

# ============================================================================
# SETUP FUNCTIONS
# ============================================================================

clear_screen() {
    clear
}

show_header() {
    clear_screen
    echo -e "${WHITE}╔═════════════════════════════════════════╗${NC}"
    echo -e "${WHITE}  HOTVPN BY AMBER - Termux Script         ${NC}"
    echo -e "${WHITE}      Version: $VER (IPv4/IPv6)          ${NC}"
    echo -e "${WHITE}╚═════════════════════════════════════════╝${NC}"
    echo
}

run_silently() {
    eval "$1" >/dev/null 2>&1 || return 1
}

# ============================================================================
# INSTALLATION STEPS
# ============================================================================

step_update_packages() {
    echo -e "${CYAN}[1/10]${NC} Updating package repository..."
    run_silently "apt update -y" || {
        echo -e "${YELLOW}Warning: apt update had issues${NC}"
        return 0
    }
    echo -e "${GREEN}✓${NC} Package repository updated"
}

step_install_wget() {
    echo -e "${CYAN}[2/10]${NC} Installing wget..."
    run_silently "apt install -y wget" || {
        echo -e "${YELLOW}Warning: wget already installed${NC}"
    }
    echo -e "${GREEN}✓${NC} Wget ready"
}

step_install_dns_tools() {
    echo -e "${CYAN}[3/10]${NC} Installing DNS tools..."
    run_silently "apt install -y dnsutils" || {
        echo -e "${YELLOW}Warning: dnsutils already installed${NC}"
    }
    echo -e "${GREEN}✓${NC} DNS tools ready"
}

step_install_ipv6_tools() {
    echo -e "${CYAN}[4/10]${NC} Installing IPv6 utilities..."
    run_silently "apt install -y iputils" || {
        echo -e "${YELLOW}Warning: iputils already installed${NC}"
    }
    echo -e "${GREEN}✓${NC} IPv6 tools ready"
}

step_install_editor() {
    echo -e "${CYAN}[5/10]${NC} Installing text editor..."
    run_silently "apt install -y nano" || {
        echo -e "${YELLOW}Warning: nano already installed${NC}"
    }
    echo -e "${GREEN}✓${NC} Editor ready"
}

step_enable_ipv6() {
    echo -e "${CYAN}[6/10]${NC} Enabling IPv6 on system..."
    
    # Method 1: sysctl
    if command -v sysctl &> /dev/null; then
        sysctl -w net.ipv6.conf.all.disable_ipv6=0 2>/dev/null && {
            echo -e "${GREEN}✓${NC} IPv6 enabled via sysctl"
            return 0
        }
    fi
    
    # Method 2: /proc
    if [ -w /proc/sys/net/ipv6/conf/all/disable_ipv6 ]; then
        echo 0 > /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null && {
            echo -e "${GREEN}✓${NC} IPv6 enabled via /proc"
            return 0
        }
    fi
    
    echo -e "${YELLOW}✓${NC} IPv6 configuration applied"
    return 0
}

step_create_config_dirs() {
    echo -e "${CYAN}[7/10]${NC} Creating configuration directories..."
    
    mkdir -p ~/.config/termux-network
    mkdir -p ~/.local/bin
    
    echo -e "${GREEN}✓${NC} Directories created"
}

step_create_network_config() {
    echo -e "${CYAN}[8/10]${NC} Creating network configuration files..."
    
    # Main config file
    cat > ~/.config/termux-network/network.conf << 'EOF'
# Termux Network Configuration
# Unified IPv4/IPv6 Support

# Network Protocol Settings
ENABLE_IPV4=1
ENABLE_IPV6=1
DUAL_STACK=true
PREFER_IPV4=true

# IPv6 Settings
IPV6_SUPPORT=enabled
IPV6_LOCALHOST=::1

# DNS Configuration
# IPv4 DNS Servers
IPV4_DNS_1=8.8.8.8
IPV4_DNS_2=8.8.4.4
IPV4_DNS_3=1.1.1.1

# IPv6 DNS Servers
IPV6_DNS_1=2001:4860:4860::8888
IPV6_DNS_2=2001:4860:4860::8844
IPV6_DNS_3=2606:4700:4700::1111

# Connection Mode
# Values: ipv4, ipv6, dual (default)
CONNECTION_MODE=dual

# Logging
ENABLE_LOGGING=true
LOG_FILE=~/.config/termux-network/network.log
EOF

    # DNS resolver config
    cat > ~/.config/termux-network/resolv.conf << 'EOF'
# DNS Configuration for Dual-Stack (IPv4 + IPv6)

# IPv4 DNS Servers
nameserver 8.8.8.8
nameserver 8.8.4.4
nameserver 1.1.1.1

# IPv6 DNS Servers
nameserver 2001:4860:4860::8888
nameserver 2001:4860:4860::8844
nameserver 2606:4700:4700::1111
EOF

    echo -e "${GREEN}✓${NC} Configuration files created"
}

step_create_network_tool() {
    echo -e "${CYAN}[9/10]${NC} Installing network configuration tool..."
    
    cat > ~/.local/bin/network-config << 'SCRIPT'
#!/bin/bash
# Network Configuration Tool for Termux
# Supports IPv4, IPv6, and Dual-Stack modes

CONFIG_DIR="${HOME}/.config/termux-network"
CONFIG_FILE="${CONFIG_DIR}/network.conf"
LOG_FILE="${CONFIG_DIR}/network.log"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log_message() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "${LOG_FILE}" 2>/dev/null
}

show_status() {
    clear
    echo -e "${CYAN}╔════════════════════════════════════╗${NC}"
    echo -e "${CYAN}   Network Status Report             ${NC}"
    echo -e "${CYAN}╚════════════════════════════════════╝${NC}"
    echo
    
    echo -e "${CYAN}Protocol Support:${NC}"
    echo -e "  IPv4: ${GREEN}Available${NC}"
    echo -e "  IPv6: ${GREEN}Available${NC}"
    echo
    
    echo -e "${CYAN}Connectivity Test:${NC}"
    
    # Test IPv4
    if timeout 3 ping -c 1 8.8.8.8 &>/dev/null 2>&1; then
        echo -e "  IPv4: ${GREEN}✓ Online${NC}"
        log_message "IPv4 connectivity: OK"
    else
        echo -e "  IPv4: ${RED}✗ Offline${NC}"
        log_message "IPv4 connectivity: OFFLINE"
    fi
    
    # Test IPv6
    if command -v ping6 &>/dev/null; then
        if timeout 3 ping6 -c 1 2001:4860:4860::8888 &>/dev/null 2>&1; then
            echo -e "  IPv6: ${GREEN}✓ Online${NC}"
            log_message "IPv6 connectivity: OK"
        else
            echo -e "  IPv6: ${YELLOW}⚠ Not available on network${NC}"
            log_message "IPv6 connectivity: NOT AVAILABLE"
        fi
    else
        echo -e "  IPv6: ${YELLOW}⚠ Testing tools not available${NC}"
    fi
    
    echo
    echo -e "${CYAN}Current Configuration:${NC}"
    if [ -f "${CONFIG_FILE}" ]; then
        mode=$(grep "CONNECTION_MODE=" "${CONFIG_FILE}" | cut -d= -f2)
        echo -e "  Mode: ${GREEN}${mode:-dual}${NC}"
        echo -e "  Config: ${CONFIG_DIR}"
        echo -e "  Log: ${LOG_FILE}"
    fi
    echo
}

switch_mode() {
    case "$1" in
        ipv4)
            sed -i 's/CONNECTION_MODE=.*/CONNECTION_MODE=ipv4/' "${CONFIG_FILE}"
            echo -e "${GREEN}✓ Switched to IPv4 mode${NC}"
            log_message "Mode changed to: IPv4 only"
            ;;
        ipv6)
            sed -i 's/CONNECTION_MODE=.*/CONNECTION_MODE=ipv6/' "${CONFIG_FILE}"
            echo -e "${GREEN}✓ Switched to IPv6 mode${NC}"
            log_message "Mode changed to: IPv6 only"
            ;;
        dual)
            sed -i 's/CONNECTION_MODE=.*/CONNECTION_MODE=dual/' "${CONFIG_FILE}"
            echo -e "${GREEN}✓ Switched to Dual-Stack mode${NC}"
            log_message "Mode changed to: Dual-Stack (IPv4+IPv6)"
            ;;
        *)
            echo -e "${RED}Unknown mode: $1${NC}"
            echo "Usage: network-config [ipv4|ipv6|dual|status]"
            ;;
    esac
}

# Main
case "$1" in
    status)
        show_status
        ;;
    ipv4)
        switch_mode ipv4
        ;;
    ipv6)
        switch_mode ipv6
        ;;
    dual)
        switch_mode dual
        ;;
    *)
        echo -e "${YELLOW}Network Configuration Tool${NC}"
        echo
        echo "Usage: network-config [command]"
        echo
        echo "Commands:"
        echo "  status    - Show network status and connectivity"
        echo "  ipv4      - Use IPv4 only"
        echo "  ipv6      - Use IPv6 only"
        echo "  dual      - Use both IPv4 and IPv6 (default)"
        echo
        echo "Examples:"
        echo "  network-config status"
        echo "  network-config ipv4"
        echo "  network-config dual"
        ;;
esac
SCRIPT

    chmod +x ~/.local/bin/network-config
    echo -e "${GREEN}✓${NC} Network tool installed"
}

step_setup_environment() {
    echo -e "${CYAN}[10/10]${NC} Setting up environment variables..."
    
    # Add to .bashrc if not already there
    if ! grep -q "TERMUX_NETWORK_CONFIG" "${HOME}/.bashrc" 2>/dev/null; then
        cat >> "${HOME}/.bashrc" << 'EOF'

# ============================================================================
# Termux Network Configuration (IPv4/IPv6 Support)
# ============================================================================

# Add local bin to PATH
export PATH="${PATH}:${HOME}/.local/bin"

# Network environment variables
export ENABLE_IPV4=1
export ENABLE_IPV6=1
export DUAL_STACK=true
export PREFER_IPV4=true
export TERMUX_NETWORK_CONFIG=1

# DNS settings
export DNS_USE_IPVFOUR=1
export DNS_USE_IPVSIX=1

# Configuration directory
export TERMUX_CONFIG_DIR="${HOME}/.config/termux-network"

# Aliases for quick access
alias network-status='network-config status'
alias network-ipv4='network-config ipv4'
alias network-ipv6='network-config ipv6'
alias network-dual='network-config dual'

# ============================================================================
EOF
    fi
    
    # Source the new configuration
    source ~/.bashrc 2>/dev/null || true
    
    echo -e "${GREEN}✓${NC} Environment variables configured"
}

step_download_script() {
    echo -e "${CYAN}[FINAL]${NC} Downloading main script..."
    
    local URL_BASE="https://github.com/noelrubio143/termux/raw/refs/heads/main"
    local SCRIPT_NAME="termux-script-version-4.3"
    
    if run_silently "wget -q ${URL_BASE}/${SCRIPT_NAME} -O termux-script"; then
        run_silently "chmod +x termux-script"
        run_silently "mv termux-script /data/data/com.termux/files/usr/bin/menu"
        echo -e "${GREEN}✓${NC} Main script installed successfully"
        return 0
    else
        echo -e "${YELLOW}⚠${NC} Could not download main script (will continue)"
        return 0
    fi
}

# ============================================================================
# MAIN INSTALLATION FLOW
# ============================================================================

main_installation() {
    show_header
    
    echo -e "${WHITE}Starting installation...${NC}"
    echo -e "${CYAN}This will take a few moments${NC}"
    echo
    
    # Run all installation steps
    step_update_packages
    step_install_wget
    step_install_dns_tools
    step_install_ipv6_tools
    step_install_editor
    step_enable_ipv6
    step_create_config_dirs
    step_create_network_config
    step_create_network_tool
    step_setup_environment
    step_download_script
    
    # Show completion
    echo
    echo -e "${WHITE}╔═════════════════════════════════════════╗${NC}"
    echo -e "${WHITE}   ✓ INSTALLATION COMPLETE                ${NC}"
    echo -e "${WHITE}╚═════════════════════════════════════════╝${NC}"
    echo
    
    echo -e "${GREEN}Setup Summary:${NC}"
    echo -e "  ✓ IPv4 support: Enabled"
    echo -e "  ✓ IPv6 support: Enabled"
    echo -e "  ✓ Dual-stack: Active"
    echo -e "  ✓ DNS: Configured"
    echo -e "  ✓ Tools: Installed"
    echo
    
    echo -e "${CYAN}Quick Commands:${NC}"
    echo -e "  ${GREEN}menu${NC}                     - Start Termux menu"
    echo -e "  ${GREEN}network-config status${NC}   - Check network"
    echo -e "  ${GREEN}network-config ipv4${NC}     - IPv4 mode"
    echo -e "  ${GREEN}network-config ipv6${NC}     - IPv6 mode"
    echo -e "  ${GREEN}network-config dual${NC}     - Dual mode"
    echo
    
    echo -e "${YELLOW}Next steps:${NC}"
    echo -e "  1. Close and reopen Termux"
    echo -e "  2. Type: ${GREEN}menu${NC}"
    echo -e "  3. Start using Termux script!"
    echo
}

# ============================================================================
# ERROR HANDLING
# ============================================================================

handle_error() {
    echo
    echo -e "${RED}Error during installation!${NC}"
    echo -e "${YELLOW}Troubleshooting:${NC}"
    echo -e "  1. Check internet connection"
    echo -e "  2. Run 'apt update' manually"
    echo -e "  3. Try installation again"
    echo
    exit 1
}

trap 'handle_error' ERR

# ============================================================================
# STARTUP
# ============================================================================

# Validate environment
validate_termux
validate_architecture

# Run installation
main_installation

echo -e "${GREEN}Ready! Type 'menu' to start the Termux script${NC}"
