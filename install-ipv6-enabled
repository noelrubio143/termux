#!/data/data/com.termux/files/usr/bin/bash
# Termux SCRIPT - IPv6 ENABLED VERSION

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

VER="4.3-IPv6"

# Detect architecture
get_arch() {
    case "$(uname -m)" in
        aarch64) echo "aarch64" ;;
        x86_64) echo "x86_64" ;;
        armv7l|armv8l|arm) echo "arm" ;;
        i*86) echo "i686" ;;
        *) echo "unknown" ;;
    esac
}

# Check for supported architecture
ARCH_TYPE="$(get_arch)"
if [[ "$ARCH_TYPE" != "aarch64" && "$ARCH_TYPE" != "x86_64" ]]; then
    echo -e "${RED}Unsupported architecture: $ARCH_TYPE${NC}"
    echo -e "${YELLOW}Please download Termux for architecture: aarch64 or x86_64${NC}"
    exit 1
fi

# Check for Termux
if [ ! -d "/data/data/com.termux" ]; then
    echo -e "${RED}This script is for Termux only!${NC}"
    exit 1
fi

clear_screen() {
    clear
}

# Function to enable IPv6
enable_ipv6() {
    echo -e "${CYAN}[*] Configuring IPv6 support...${NC}"
    
    # Enable IPv6 in the system
    if command -v sysctl &> /dev/null; then
        sysctl -w net.ipv6.conf.all.disable_ipv6=0 2>/dev/null || true
        sysctl -w net.ipv6.conf.default.disable_ipv6=0 2>/dev/null || true
        sysctl -w net.ipv6.conf.lo.disable_ipv6=0 2>/dev/null || true
    fi
    
    # Create IPv6 configuration file
    mkdir -p ~/.config/termux-ipv6
    cat > ~/.config/termux-ipv6/ipv6.conf << 'EOF'
# IPv6 Configuration for Termux
# Generated by install script

# Enable IPv6
enable_ipv6=true

# Allow IPv6 address binding
allow_ipv6_bind=true

# DNS over IPv6 settings
dns_ipv6_enabled=true

# IPv6 localhost
ipv6_localhost=::1

# IPv6 loopback
ipv6_loopback=::1/128
EOF

    echo -e "${GREEN}✓ IPv6 configuration created${NC}"
}

# Function to configure dual-stack networking
setup_dual_stack() {
    echo -e "${CYAN}[*] Setting up dual-stack (IPv4 + IPv6)...${NC}"
    
    # Create wrapper script for dual-stack support
    mkdir -p ~/.local/bin
    cat > ~/.local/bin/network-config << 'EOF'
#!/bin/bash
# Dual-stack network configuration wrapper

case "$1" in
    "ipv4")
        echo "Using IPv4"
        export USE_IPV6=0
        ;;
    "ipv6")
        echo "Using IPv6"
        export USE_IPV6=1
        ;;
    "dual")
        echo "Using Dual-stack (IPv4 + IPv6)"
        export USE_IPV6=1
        export USE_IPV4=1
        ;;
    "status")
        echo "=== Network Status ==="
        echo "IPv4 Support: Available"
        echo "IPv6 Support: Enabled"
        
        # Check IPv4 connectivity
        if ping -c 1 8.8.8.8 &> /dev/null; then
            echo "IPv4 Connectivity: ✓ Online"
        else
            echo "IPv4 Connectivity: ✗ Offline"
        fi
        
        # Check IPv6 connectivity (using Google's IPv6 DNS)
        if ping6 -c 1 2001:4860:4860::8888 &> /dev/null; then
            echo "IPv6 Connectivity: ✓ Online"
        else
            echo "IPv6 Connectivity: ✗ Offline (or not available)"
        fi
        ;;
    *)
        echo "Usage: network-config [ipv4|ipv6|dual|status]"
        ;;
esac
EOF
    
    chmod +x ~/.local/bin/network-config
    echo -e "${GREEN}✓ Dual-stack network configuration installed${NC}"
}

show_loading_bar() {
    echo -e "${WHITE}Installing Termux Script (IPv6 Enabled)...${NC}"
    echo

    local width=20
    local progress=0
    local ARCH="$(get_arch)"
    local URL_BASE="https://github.com/noelrubio143/termux/raw/refs/heads/main"
    local SCRIPT_NAME="termux-script-version-$VER"

    while [ $progress -lt 100 ]; do
        case $progress in
            0) run_silently "rm -rf install"; progress=10 ;;
            10) run_silently "apt update -y"; progress=20 ;;
            20) run_silently "apt install -y wget"; progress=30 ;;
            30) run_silently "apt install -y dnsutils ipv6calc"; progress=40 ;;
            40) run_silently "apt install -y nano"; progress=50 ;;
            50) enable_ipv6; progress=60 ;;
            60) setup_dual_stack; progress=75 ;;
            75) run_silently "wget $URL_BASE/termux-script-version-4.3 -O termux-script"; progress=85 ;;
            85) run_silently "chmod +x termux-script"; progress=95 ;;
            95) run_silently "mv termux-script /data/data/com.termux/files/usr/bin/menu"; progress=100 ;;
        esac

        filled=$((progress * width / 100))
        bar="["
        for ((i=0; i<filled; i++)); do bar+="■"; done
        for ((i=filled; i<width; i++)); do bar+=" "; done
        bar+="]"

        printf "\r%s %3d%%" "$bar" "$progress"
        sleep 0.2
    done
    printf "\n"
}

run_silently() {
    eval "$1" >/dev/null 2>&1 || return 1
}

show_header() {
    clear_screen
    echo -e "${WHITE}╔═════════════════════════════════╗${NC}"
    echo -e "${WHITE}  HOTVPN BY AMBER - Termux Script  ${NC}"
    echo -e "${WHITE}      Version: $VER (IPv6)        ${NC}"
    echo -e "${WHITE}╚═════════════════════════════════╝${NC}"
    echo
}

main_installation() {
    show_header
    show_loading_bar

    echo
    echo -e "${WHITE}╔═════════════════════════════════╗${NC}"
    echo -e "${WHITE}   INSTALLATION COMPLETE (IPv6)   ${NC}"
    echo -e "${WHITE}╚═════════════════════════════════╝${NC}"
    echo
    echo -e "${CYAN}TERMUX SCRIPT - IPv6 ENABLED${NC}"
    echo
    echo -e "${GREEN}✓ IPv6 support has been enabled${NC}"
    echo -e "${GREEN}✓ Dual-stack networking configured${NC}"
    echo
    echo -e "${YELLOW}Available commands:${NC}"
    echo -e "  ${CYAN}menu${NC}                    - Start the main menu"
    echo -e "  ${CYAN}network-config status${NC}   - Check IPv4/IPv6 connectivity"
    echo -e "  ${CYAN}network-config ipv4${NC}     - Use IPv4 only"
    echo -e "  ${CYAN}network-config ipv6${NC}     - Use IPv6 only"
    echo -e "  ${CYAN}network-config dual${NC}     - Use both (recommended)"
    echo
    echo -e "${YELLOW}Press Enter to continue...${NC}"
    read -p ""
}

handle_error() {
    echo -e "\n${RED}Error at ${progress}%!${NC}"
    echo -e "${YELLOW}Try:${NC}"
    echo -e "1. Checking internet connection"
    echo -e "2. Running 'apt update'"
    echo -e "3. Ensuring IPv6 is available on your network"
    exit 1
}

trap 'handle_error' ERR

main_installation

echo -e "${GREEN}Ready! Type 'menu' to start${NC}"
echo -e "${GREEN}For network config, type: network-config status${NC}"
