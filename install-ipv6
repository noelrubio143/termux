#!/data/data/com.termux/files/usr/bin/bash
# Termux Script Unified Installer with IPv4/IPv6
# Downloads all files from GitHub + enables IPv6
# Single command installation

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

VER="4.3-UNIFIED"
GITHUB_URL="https://github.com/noelrubio143/termux/raw/refs/heads/main"

# Validation
if [ ! -d "/data/data/com.termux" ]; then
    echo -e "${RED}ERROR: Termux only!${NC}"
    exit 1
fi

ARCH=$(uname -m)
if [[ "$ARCH" != "aarch64" && "$ARCH" != "x86_64" ]]; then
    echo -e "${RED}Unsupported: $ARCH${NC}"
    exit 1
fi

clear
echo -e "${WHITE}╔═════════════════════════════════════╗${NC}"
echo -e "${WHITE}  HOTVPN - Termux Script             ${NC}"
echo -e "${WHITE}      Version: $VER (IPv4/IPv6)      ${NC}"
echo -e "${WHITE}╚═════════════════════════════════════╝${NC}"
echo

# Helper function
run_cmd() {
    eval "$1" >/dev/null 2>&1
}

# Step 1-5: Install dependencies
echo -e "${CYAN}[1/15]${NC} Updating packages..."
run_cmd "apt update -y"
echo -e "${GREEN}✓${NC}"

echo -e "${CYAN}[2/15]${NC} Installing wget..."
run_cmd "apt install -y wget"
echo -e "${GREEN}✓${NC}"

echo -e "${CYAN}[3/15]${NC} Installing DNS tools..."
run_cmd "apt install -y dnsutils"
echo -e "${GREEN}✓${NC}"

echo -e "${CYAN}[4/15]${NC} Installing IPv6 utilities..."
run_cmd "apt install -y iputils"
echo -e "${GREEN}✓${NC}"

echo -e "${CYAN}[5/15]${NC} Installing nano..."
run_cmd "apt install -y nano"
echo -e "${GREEN}✓${NC}"

# Step 6: Enable IPv6
echo -e "${CYAN}[6/15]${NC} Enabling IPv6..."
if command -v sysctl &>/dev/null; then
    sysctl -w net.ipv6.conf.all.disable_ipv6=0 2>/dev/null
fi
if [ -w /proc/sys/net/ipv6/conf/all/disable_ipv6 ]; then
    echo 0 > /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null
fi
echo -e "${GREEN}✓${NC}"

# Step 7: Create directories
echo -e "${CYAN}[7/15]${NC} Creating directories..."
mkdir -p ~/.config/termux-network
mkdir -p ~/.local/bin
echo -e "${GREEN}✓${NC}"

# Step 8: Download and install client
echo -e "${CYAN}[8/15]${NC} Downloading client binary..."
if wget -q "${GITHUB_URL}/client" -O ~/.local/termux-client; then
    chmod +x ~/.local/termux-client
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${YELLOW}⚠${NC}"
fi

# Step 9: Download index.html
echo -e "${CYAN}[9/15]${NC} Downloading web dashboard..."
if wget -q "${GITHUB_URL}/index.html" -O ~/.config/termux-network/index.html; then
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${YELLOW}⚠${NC}"
fi

# Step 10: Download script versions
echo -e "${CYAN}[10/15]${NC} Downloading script v4.3..."
if wget -q "${GITHUB_URL}/termux-script-version-4.3" -O /data/data/com.termux/files/usr/bin/menu; then
    chmod +x /data/data/com.termux/files/usr/bin/menu
    echo -e "${GREEN}✓${NC}"
else
    echo -e "${YELLOW}⚠${NC}"
fi

# Step 11: Create config files
echo -e "${CYAN}[11/15]${NC} Creating config files..."
cat > ~/.config/termux-network/network.conf << 'EOF'
ENABLE_IPV4=1
ENABLE_IPV6=1
DUAL_STACK=true
PREFER_IPV4=true
CONNECTION_MODE=dual
ENABLE_LOGGING=true
LOG_FILE=~/.config/termux-network/network.log
EOF

cat > ~/.config/termux-network/resolv.conf << 'EOF'
nameserver 8.8.8.8
nameserver 8.8.4.4
nameserver 1.1.1.1
nameserver 2001:4860:4860::8888
nameserver 2001:4860:4860::8844
nameserver 2606:4700:4700::1111
EOF
echo -e "${GREEN}✓${NC}"

# Step 12: Create network-config tool
echo -e "${CYAN}[12/15]${NC} Creating network config tool..."
cat > ~/.local/bin/network-config << 'TOOL'
#!/bin/bash
CONFIG_DIR="${HOME}/.config/termux-network"
CONFIG_FILE="${CONFIG_DIR}/network.conf"
LOG_FILE="${CONFIG_DIR}/network.log"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

case "$1" in
    status)
        echo -e "${CYAN}Network Status:${NC}"
        echo -e "  IPv4: ${GREEN}Available${NC}"
        echo -e "  IPv6: ${GREEN}Available${NC}"
        echo
        
        if timeout 3 ping -c 1 8.8.8.8 &>/dev/null; then
            echo -e "  IPv4: ${GREEN}✓ Online${NC}"
        else
            echo -e "  IPv4: ${RED}✗ Offline${NC}"
        fi
        
        if command -v ping6 &>/dev/null; then
            if timeout 3 ping6 -c 1 2001:4860:4860::8888 &>/dev/null; then
                echo -e "  IPv6: ${GREEN}✓ Online${NC}"
            else
                echo -e "  IPv6: ${YELLOW}⚠ Not available on network${NC}"
            fi
        fi
        ;;
    ipv4)
        sed -i 's/CONNECTION_MODE=.*/CONNECTION_MODE=ipv4/' "${CONFIG_FILE}"
        echo -e "${GREEN}✓ IPv4 mode${NC}"
        ;;
    ipv6)
        sed -i 's/CONNECTION_MODE=.*/CONNECTION_MODE=ipv6/' "${CONFIG_FILE}"
        echo -e "${GREEN}✓ IPv6 mode${NC}"
        ;;
    dual)
        sed -i 's/CONNECTION_MODE=.*/CONNECTION_MODE=dual/' "${CONFIG_FILE}"
        echo -e "${GREEN}✓ Dual-stack mode${NC}"
        ;;
    *)
        echo "Usage: network-config [status|ipv4|ipv6|dual]"
        ;;
esac
TOOL

chmod +x ~/.local/bin/network-config
echo -e "${GREEN}✓${NC}"

# Step 13: Update bashrc with PATH
echo -e "${CYAN}[13/15]${NC} Updating environment..."
if ! grep -q "TERMUX_NETWORK_CONFIG" "${HOME}/.bashrc" 2>/dev/null; then
    cat >> "${HOME}/.bashrc" << 'BASHRC'

export PATH="${PATH}:${HOME}/.local/bin"
export ENABLE_IPV4=1
export ENABLE_IPV6=1
export DUAL_STACK=true
export TERMUX_NETWORK_CONFIG=1
export DNS_USE_IPVFOUR=1
export DNS_USE_IPVSIX=1
export TERMUX_CONFIG_DIR="${HOME}/.config/termux-network"

alias menu="/data/data/com.termux/files/usr/bin/menu"
alias network-status='network-config status'
alias network-ipv4='network-config ipv4'
alias network-ipv6='network-config ipv6'
alias network-dual='network-config dual'
BASHRC
fi

source ~/.bashrc 2>/dev/null || true
echo -e "${GREEN}✓${NC}"

# Step 14: Cleanup
echo -e "${CYAN}[14/15]${NC} Cleaning up..."
run_cmd "rm -rf install"
echo -e "${GREEN}✓${NC}"

# Step 15: Final message
echo -e "${CYAN}[15/15]${NC} Setup complete..."
echo -e "${GREEN}✓${NC}"

echo
echo -e "${WHITE}╔═════════════════════════════════════╗${NC}"
echo -e "${WHITE}   INSTALLATION COMPLETE             ${NC}"
echo -e "${WHITE}╚═════════════════════════════════════╝${NC}"
echo
echo -e "${GREEN}✓ IPv4 support: Enabled${NC}"
echo -e "${GREEN}✓ IPv6 support: Enabled${NC}"
echo -e "${GREEN}✓ DNS: Configured for both${NC}"
echo -e "${GREEN}✓ Tools: Installed${NC}"
echo -e "${GREEN}✓ Network: Dual-stack ready${NC}"
echo
echo -e "${CYAN}Available commands:${NC}"
echo -e "  ${WHITE}menu${NC}                    - Open Termux menu"
echo -e "  ${WHITE}network-config status${NC}   - Check network"
echo -e "  ${WHITE}network-config ipv4${NC}     - IPv4 only"
echo -e "  ${WHITE}network-config ipv6${NC}     - IPv6 only"
echo -e "  ${WHITE}network-config dual${NC}     - Both (default)"
echo
echo -e "${YELLOW}IMPORTANT:${NC}"
echo -e "  Close and reopen Termux for changes"
echo -e "  to take effect!"
echo
echo -e "${GREEN}Ready! Type 'menu' to start${NC}"
